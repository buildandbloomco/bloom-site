# Password for /admin (pick something long)
ADMIN_PASSWORD=

# Long random string used to sign logins and encrypt access codes.
# Generate one at https://generate-secret.vercel.app/64 and never change it after launch.
SESSION_SECRET=

# Storage: added automatically when you connect Upstash Redis in Vercel (Storage tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stripe (Dashboard > Developers > API keys). Leave blank until you're ready for payments.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (Dashboard > Developers > Webhooks) so payments show up in admin automatically
STRIPE_WEBHOOK_SECRET=
